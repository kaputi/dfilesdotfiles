#compdef ,sshmount
# ,sshmount user@host[:/path] [DIR] | -u [DIR]: complete local directories for DIR,
# or the active sshfs mounts when unmounting (-u). The remote isn't completed.

local -a mounts expl
local w n=0

# positional arguments before the cursor
for w in $words[2,CURRENT-1]; do
    [[ $w == -* ]] || (( n++ ))
done

if (( $words[(I)-u] )); then
    (( n == 0 )) || return 1
    # /proc/self/mounts writes space, tab, newline and backslash as \040 \011 \012 \134
    mounts=(${(f)"$(awk '$3 == "fuse.sshfs" { print $2 }' /proc/self/mounts)"})
    mounts=(${(g:o:)mounts})
    _wanted mounts expl 'sshfs mount' compadd -a mounts
elif (( n == 1 )); then
    _files -/
else
    return 1
fi
