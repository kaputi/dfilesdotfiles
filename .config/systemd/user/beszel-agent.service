# Beszel agent for the tower (langoliers), as a systemd *user* service.
# The user is in the docker group, so it reads the system-wide Docker's
# container stats. arrStack's rootless Docker has its own agent (tower-arr,
# run by arrstack; ~/code/arrStack/beszel/). Linger is on: starts at boot,
# no login.
# Binary + secrets in ~/.local/share/beszel-agent/ (not tracked by dfiles);
# this unit in ~/.config/systemd/user/ (tracked by dfiles: no secrets here).
[Unit]
Description=Beszel agent (tower)
After=network-online.target

[Service]
ExecStart=%h/.local/share/beszel-agent/beszel-agent
EnvironmentFile=%h/.local/share/beszel-agent/agent.env
Environment=DATA_DIR=%h/.local/share/beszel-agent/data
# Connects out to the hub on LabPi-1 over WebSocket; no SSH listener needed.
Environment=DISABLE_SSH=true
# SMART: the agent runs the first "smartctl" on its PATH; ours is a stand-in
# that asks the root-owned read-only gate (/usr/local/bin/smartctl-ro) via sudo.
Environment=PATH=%h/.local/share/beszel-agent/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
