#!/usr/bin/env bash
# Make a git worktree for an existing branch and symlink ignored local files into it.
#
#   ,wt    run it inside a git repo; it asks for everything
#
# Branch: local and remote branches, newest first. Ones already checked out in a
#   worktree are hidden; a remote branch gets a local tracking branch.
# Destination: prefilled with the next free <repo>-wt, <repo>-wt2... beside the main
#   worktree. Created if missing; refused if it's a file or a non-empty dir.
# Files: git-ignored files matching the globs in ~/.config/kaputi/wt/links, searched
#   in the main worktree minus the folders in ~/.config/kaputi/wt/skip. All start
#   checked; links are absolute and point into the main worktree.
# Nothing is created until every question is answered. stdout gets only the new
# path, so the ,wt zsh function can cd there.

set -u

usage="usage: ,wt (no arguments, run it inside a git repo)"
die() { printf ',wt: %s\n' "$*" >&2; exit 1; }
cancel() { die "cancelled, nothing created"; }

if (( $# )); then
    case $1 in
        -h|--help) sed -n '2,14s/^# \{0,1\}//p' "$0"; exit 0 ;;
        *) die "unknown argument: $1 ($usage)" ;;
    esac
fi
trap cancel INT

conf=${XDG_CONFIG_HOME:-$HOME/.config}/kaputi/wt
command -v fzf > /dev/null || die "needs fzf"
git rev-parse --git-dir > /dev/null 2>&1 || die "not a git repo"

# The first worktree listed is the main one; the rest may sit inside it
wts=()
declare -A busy
while IFS= read -r line; do
    case $line in
        'worktree '*) wts+=("${line#worktree }") ;;
        'branch '*) busy[${line#branch }]=1 ;;
        bare) (( ${#wts[@]} == 1 )) && die "bare repo: no main worktree to link files from" ;;
    esac
done < <(git worktree list --porcelain)
main=${wts[0]}

# One entry per line; blank lines and # comments ignored
read_list() {
    [[ -f $1 ]] || return 0
    sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^#/d' -e '/^$/d' "$1"
}
[[ -f $conf/links ]] || die "no whitelist: create $conf/links (one glob per line, e.g. *.env*)"
mapfile -t links < <(read_list "$conf/links")
mapfile -t skips < <(read_list "$conf/skip")

# Branch: "<ref> TAB <name> TAB <age>", fzf shows name and age
declare -A local_br
while IFS= read -r b; do local_br[$b]=1; done < <(git for-each-ref --format='%(refname:lstrip=2)' refs/heads)
lines=()
while IFS=$'\t' read -r ref age; do
    case $ref in
        refs/heads/*)
            [[ -n ${busy[$ref]-} ]] && continue
            lines+=("$ref"$'\t'"${ref#refs/heads/}"$'\t'"$age") ;;
        refs/remotes/*/HEAD) ;;
        refs/remotes/*)
            name=${ref#refs/remotes/}
            [[ -n ${local_br[${name#*/}]-} ]] && continue
            lines+=("$ref"$'\t'"$name"$'\t'"$age") ;;
    esac
done < <(git for-each-ref --sort=-committerdate --format='%(refname)%09%(committerdate:relative)' refs/heads refs/remotes)
(( ${#lines[@]} )) || die "no branch available (all are checked out in a worktree)"

pick=$(printf '%s\n' "${lines[@]}" | fzf --delimiter '\t' --with-nth 2.. --no-sort \
    --height '~50%' --reverse --prompt 'branch> ' --header 'Esc cancels') || cancel
ref=${pick%%$'\t'*}

# Destination
repo=${main##*/}
n=1
while :; do
    default=${main%/*}/$repo-wt
    (( n > 1 )) && default+=$n
    [[ -e $default || -L $default ]] || break
    n=$((n + 1))
done
[[ $default == "$HOME"/* ]] && default="~${default#"$HOME"}"
IFS= read -r -e -i "$default" -p 'destination: ' dest || cancel
[[ -z $dest ]] && dest=$default
[[ $dest == "~" ]] && dest=$HOME
[[ $dest == "~/"* ]] && dest=$HOME/${dest#"~/"}
[[ $dest == /* ]] || dest=$PWD/$dest
dest=$(realpath -m -- "$dest")
if [[ -e $dest || -L $dest ]]; then
    [[ -d $dest ]] || die "$dest exists and is not a directory"
    [[ -z $(ls -A -- "$dest") ]] || die "$dest is not empty"
fi

# Files: whitelist matches in the main worktree that git ignores
cands=()
if (( ${#links[@]} )); then
    args=("$main" '(' -name .git)
    for s in "${skips[@]}"; do args+=(-o -name "$s"); done
    for w in "${wts[@]:1}"; do [[ $w == "$main"/* ]] && args+=(-o -path "$w"); done
    args+=(')' -prune -o '(' -type f -o -type l ')' '(')
    for i in "${!links[@]}"; do
        (( i )) && args+=(-o)
        if [[ ${links[i]} == */* ]]; then
            args+=(-path "$main/${links[i]}")
        else
            args+=(-name "${links[i]}")
        fi
    done
    args+=(')' -printf '%P\n')
    mapfile -t cands < <(find "${args[@]}" 2> /dev/null | git -C "$main" check-ignore --stdin | sort)
fi

chosen=()
if (( ${#cands[@]} )); then
    # Enter with nothing checked must link nothing; plain fzf would return the focused line
    picked=$(printf '%s\n' "${cands[@]}" | fzf --multi --height '~50%' --reverse --prompt 'link> ' \
        --header 'Tab toggles · type to filter · Enter confirms · Esc cancels' \
        --bind 'load:select-all' \
        --bind 'enter:become(if [ "$FZF_SELECT_COUNT" -gt 0 ]; then cat {+f}; fi)') || cancel
    [[ -n $picked ]] && mapfile -t chosen <<< "$picked"
else
    echo "nothing to link" >&2
fi

# Everything answered: create
trap - INT
if [[ $ref == refs/heads/* ]]; then
    branch=${ref#refs/heads/}
    git -C "$main" worktree add "$dest" "$branch" >&2 || die "git worktree add failed, nothing linked"
else
    remote_branch=${ref#refs/remotes/}
    branch=${remote_branch#*/}
    git -C "$main" worktree add --track -b "$branch" "$dest" "$remote_branch" >&2 \
        || die "git worktree add failed, nothing linked"
fi

linked=0
skipped=()
for p in "${chosen[@]}"; do
    if [[ -e $dest/$p || -L $dest/$p ]]; then
        printf ',wt: %s already exists in the worktree (tracked on %s?), not linked\n' "$p" "$branch" >&2
        skipped+=("$p")
    elif mkdir -p -- "$(dirname -- "$dest/$p")" && ln -s -- "$main/$p" "$dest/$p"; then
        linked=$((linked + 1))
    else
        printf ',wt: could not link %s\n' "$p" >&2
        skipped+=("$p")
    fi
done

{
    printf '\nworktree  %s\nbranch    %s\nlinked    %d file(s)\n' "$dest" "$branch" "$linked"
    (( ${#skipped[@]} )) && printf 'skipped   %s\n' "${skipped[@]}"
} >&2
printf '%s\n' "$dest"
