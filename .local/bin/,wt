#!/usr/bin/env bash
# Make a git worktree for a branch and bring ignored local files into it.
#
#   ,wt    run it inside a git repo; it asks for everything
#
# Branch: local and remote branches, newest first. Ones already checked out in a
#   worktree are hidden; a remote branch gets a local tracking branch. Ctrl-N
#   makes a new branch named after the typed text instead, from a base you pick
#   (current branch first). It tracks nothing until your first push -u.
# Destination: prefilled with the next free <repo>-wt, <repo>-wt2... beside the main
#   worktree. Created if missing; refused if it's a file or a non-empty dir.
# Files: a table of what ~/.config/kaputi/wt/offer matches (one glob per line):
#   files git ignores, and folders with nothing tracked inside. Folders named in
#   ~/.config/kaputi/wt/skip aren't searched unless offer lists them. Rows start
#   off; Tab cycles off -> link -> copy (folders: off -> copy). Links are absolute,
#   into the main worktree; copies use cp --reflink=auto (cheap on btrfs).
# Nothing is created until every question is answered. stdout gets only the new
# path, so the ,wt zsh function can cd there.

set -u

usage="usage: ,wt (no arguments, run it inside a git repo)"
die() { printf ',wt: %s\n' "$*" >&2; exit 1; }
cancel() { die "cancelled, nothing created"; }

if (( $# )); then
    case $1 in
        -h|--help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
        *) die "unknown argument: $1 ($usage)" ;;
    esac
fi
trap cancel INT

conf=${XDG_CONFIG_HOME:-$HOME/.config}/kaputi/wt
command -v fzf > /dev/null || die "needs fzf"
git rev-parse --git-dir > /dev/null 2>&1 || die "not a git repo"

# The first worktree listed is the main one; the rest may sit inside it
wts=()
declare -A busy
while IFS= read -r line; do
    case $line in
        'worktree '*) wts+=("${line#worktree }") ;;
        'branch '*) busy[${line#branch }]=1 ;;
        bare) (( ${#wts[@]} == 1 )) && die "bare repo: no main worktree to link files from" ;;
    esac
done < <(git worktree list --porcelain)
main=${wts[0]}

# One entry per line; blank lines and # comments ignored
read_list() {
    [[ -f $1 ]] || return 0
    sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^#/d' -e '/^$/d' "$1"
}
[[ -f $conf/offer ]] || die "no whitelist: create $conf/offer (one glob per line, e.g. *.env*)"
mapfile -t offers < <(read_list "$conf/offer")
mapfile -t skips < <(read_list "$conf/skip")

# Branch: "<ref> TAB <name> TAB <age>", fzf shows name and age. lines: branches
# free to check out. bases: everything a new branch can start from, current first.
declare -A local_br
while IFS= read -r b; do local_br[$b]=1; done < <(git for-each-ref --format='%(refname:lstrip=2)' refs/heads)
cur=$(git symbolic-ref -q HEAD)
lines=()
bases=()
while IFS=$'\t' read -r ref age; do
    case $ref in
        refs/remotes/*/HEAD) continue ;;
        refs/heads/*)
            name=${ref#refs/heads/}
            [[ -n ${busy[$ref]-} ]] || lines+=("$ref"$'\t'"$name"$'\t'"$age") ;;
        refs/remotes/*)
            name=${ref#refs/remotes/}
            [[ -n ${local_br[${name#*/}]-} ]] || lines+=("$ref"$'\t'"$name"$'\t'"$age") ;;
    esac
    if [[ $ref == "$cur" ]]; then
        bases=("$ref"$'\t'"$name (current)"$'\t'"$age" "${bases[@]}")
    else
        bases+=("$ref"$'\t'"$name"$'\t'"$age")
    fi
done < <(git for-each-ref --sort=-committerdate --format='%(refname)%09%(committerdate:relative)' refs/heads refs/remotes)
if [[ -z $cur ]] && head=$(git rev-parse -q --verify HEAD); then
    bases=("$head"$'\t'"HEAD (detached)"$'\t'"$(git log -1 --format=%cr HEAD)" "${bases[@]}")
fi

# Ctrl-N prints "new TAB <typed text>"; the header shows the name it would use
hint='Ctrl-N new branch · Esc cancels'
pick=$({ (( ${#lines[@]} )) && printf '%s\n' "${lines[@]}"; } | fzf --delimiter '\t' --with-nth 2.. --no-sort \
    --height '~50%' --reverse --prompt 'branch> ' --header "$hint" \
    --ghost 'filter, or type a new branch name' --with-shell 'sh -c' \
    --bind "change:transform-header:[ -z {q} ] && echo '$hint' || printf \"Ctrl-N creates '%s' · Esc cancels\" {q}" \
    --bind 'ctrl-n:become(printf "new\t%s\n" {q})') || cancel
ref=${pick%%$'\t'*}

# Why a new branch name can't be used; nothing if it can
name_problem() {
    if [[ -z $1 ]]; then
        echo "no name"
    elif [[ -n ${local_br[$1]-} ]]; then
        echo "branch $1 already exists"
    elif [[ $1 == -* || $1 == HEAD ]] || ! git check-ref-format "refs/heads/$1"; then
        echo "$1 is not a valid branch name"
    fi
}

case $ref in
    new)
        branch=${pick#new$'\t'}
        while problem=$(name_problem "$branch"); [[ -n $problem ]]; do
            [[ -n $branch ]] && printf ',wt: %s\n' "$problem" >&2
            IFS= read -r -e -i "$branch" -p 'new branch name: ' branch || cancel
        done
        (( ${#bases[@]} )) || die "no commit to start $branch from"
        base_pick=$(printf '%s\n' "${bases[@]}" | fzf --delimiter '\t' --with-nth 2.. --no-sort \
            --height '~50%' --reverse --prompt "base for $branch> " --header 'Esc cancels') || cancel
        base=${base_pick%%$'\t'*}
        base_name=${base_pick#*$'\t'}
        base_name=${base_name%%$'\t'*}
        base_name=${base_name% (current)}
        [[ $base == refs/* ]] || base_name=$(git rev-parse --short "$base")
        label="$branch (new, from $base_name)" ;;
    refs/heads/*)
        branch=${ref#refs/heads/}
        label=$branch ;;
    *)
        remote_branch=${ref#refs/remotes/}
        branch=${remote_branch#*/}
        label=$branch ;;
esac

# Destination
repo=${main##*/}
n=1
while :; do
    default=${main%/*}/$repo-wt
    (( n > 1 )) && default+=$n
    [[ -e $default || -L $default ]] || break
    n=$((n + 1))
done
[[ $default == "$HOME"/* ]] && default="~${default#"$HOME"}"
IFS= read -r -e -i "$default" -p 'destination: ' dest || cancel
[[ -z $dest ]] && dest=$default
[[ $dest == "~" ]] && dest=$HOME
[[ $dest == "~/"* ]] && dest=$HOME/${dest#"~/"}
[[ $dest == /* ]] || dest=$PWD/$dest
dest=$(realpath -m -- "$dest")
if [[ -e $dest || -L $dest ]]; then
    [[ -d $dest ]] || die "$dest exists and is not a directory"
    [[ -z $(ls -A -- "$dest") ]] || die "$dest is not empty"
fi

# Rows: what the offer list matches in the main worktree. Files must be ignored by
# git; folders must have nothing tracked inside and are never searched into.
paths=()   # as shown: folders end in /
kinds=()   # file or dir
if (( ${#offers[@]} )); then
    match=()
    for g in "${offers[@]}"; do
        g=${g%/}
        (( ${#match[@]} )) && match+=(-o)
        if [[ $g == */* ]]; then match+=(-path "$main/$g"); else match+=(-name "$g"); fi
    done
    nested=(-name .git)
    for w in "${wts[@]:1}"; do [[ $w == "$main"/* ]] && nested+=(-o -path "$w"); done
    skip=(-false)
    for s in "${skips[@]}"; do skip+=(-o -name "$s"); done
    # The folder test runs before skip, so a listed folder shows even when skipped
    files=()
    while IFS=$'\t' read -r kind p; do
        if [[ $kind == file ]]; then
            files+=("$p")
        elif [[ -z $(git -C "$main" ls-files -- ":(literal)$p" | head -n 1) ]]; then
            paths+=("$p/")
            kinds+=(dir)
        fi
    done < <(find "$main" -mindepth 1 '(' "${nested[@]}" ')' -prune \
        -o -type d '(' "${match[@]}" ')' -printf 'dir\t%P\n' -prune \
        -o '(' "${skip[@]}" ')' -prune \
        -o '(' -type f -o -type l ')' '(' "${match[@]}" ')' -printf 'file\t%P\n' 2> /dev/null)
    if (( ${#files[@]} )); then
        while IFS= read -r p; do
            paths+=("$p")
            kinds+=(file)
        done < <(printf '%s\n' "${files[@]}" | git -C "$main" check-ignore --stdin)
    fi
fi

# Sort rows by path, keeping kinds in step
if (( ${#paths[@]} )); then
    mapfile -t order < <(for i in "${!paths[@]}"; do printf '%s\t%s\n' "${paths[i]}" "$i"; done \
        | LC_ALL=C sort -t $'\t' -k1,1 | cut -f2)
    sorted_paths=() sorted_kinds=()
    for i in "${order[@]}"; do
        sorted_paths+=("${paths[i]}")
        sorted_kinds+=("${kinds[i]}")
    done
    paths=("${sorted_paths[@]}") kinds=("${sorted_kinds[@]}")
fi
state=()   # per row: 0 off, 1 link, 2 copy
for i in "${!paths[@]}"; do state[i]=0; done

# The link/copy table, drawn on stderr. Files cycle off -> link -> copy, folders
# off -> copy. Returns 1 on Esc.
table() {
    local n=${#paths[@]} cur=0 i key rest mark pointer
    local where=$dest
    [[ $where == "$HOME"/* ]] && where="~${where#"$HOME"}"
    printf '\nfiles for %s\n↑/↓ move · Tab off→link→copy · Enter ok · Esc cancel\n\n' "$where" >&2
    trap 'printf "\e[?25h" >&2' EXIT
    printf '\e[?25l' >&2
    while :; do
        for i in "${!paths[@]}"; do
            case ${state[i]} in
                1) mark=$'\e[36mlink\e[0m' ;;
                2) mark=$'\e[33mcopy\e[0m' ;;
                *) mark='    ' ;;
            esac
            pointer=' '
            (( i == cur )) && pointer='>'
            printf '\r\e[2K%s %s  %s\n' "$pointer" "$mark" "${paths[i]}" >&2
        done
        IFS= read -rsn1 -d '' key < /dev/tty || return 1
        if [[ $key == $'\e' ]]; then
            # Arrow keys arrive as Esc [ A; a lone Esc has nothing after it
            IFS= read -rsn2 -t 0.05 -d '' rest < /dev/tty
            key+=$rest
        fi
        case $key in
            $'\e[A' | $'\eOA' | k) (( cur > 0 )) && cur=$((cur - 1)) ;;
            $'\e[B' | $'\eOB' | j) (( cur < n - 1 )) && cur=$((cur + 1)) ;;
            $'\t')
                if [[ ${kinds[cur]} == dir ]]; then
                    state[cur]=$(( state[cur] ? 0 : 2 ))
                else
                    state[cur]=$(( (state[cur] + 1) % 3 ))
                fi ;;
            $'\n' | $'\r') printf '\e[?25h' >&2; return 0 ;;
            $'\e') return 1 ;;
        esac
        printf '\e[%dA' "$n" >&2
    done
}

if (( ${#paths[@]} )); then
    table || cancel
else
    echo "nothing to link or copy" >&2
fi

# Everything answered: create
trap - INT
case $ref in
    # --no-track: a branch started from origin/main must not push to origin/main
    new) git -C "$main" worktree add --no-track -b "$branch" "$dest" "$base" >&2 ;;
    refs/heads/*) git -C "$main" worktree add "$dest" "$branch" >&2 ;;
    *) git -C "$main" worktree add --track -b "$branch" "$dest" "$remote_branch" >&2 ;;
esac || die "git worktree add failed, nothing linked"

linked=0
copied=0
skipped=()
for i in "${!paths[@]}"; do
    (( state[i] )) || continue
    p=${paths[i]%/}
    if [[ -e $dest/$p || -L $dest/$p ]]; then
        printf ',wt: %s already exists in the worktree (tracked on %s?), skipped\n' "${paths[i]}" "$branch" >&2
        skipped+=("${paths[i]}")
        continue
    fi
    if (( state[i] == 1 )); then
        mkdir -p -- "$(dirname -- "$dest/$p")" && ln -s -- "$main/$p" "$dest/$p" \
            && { linked=$((linked + 1)); continue; }
    else
        [[ ${kinds[i]} == dir ]] && printf 'copying %s…\n' "${paths[i]}" >&2
        mkdir -p -- "$(dirname -- "$dest/$p")" && cp -a --reflink=auto -- "$main/$p" "$dest/$p" \
            && { copied=$((copied + 1)); continue; }
    fi
    printf ',wt: could not bring in %s\n' "${paths[i]}" >&2
    skipped+=("${paths[i]}")
done

{
    printf '\nworktree  %s\nbranch    %s\nlinked    %d file(s)\n' "$dest" "$label" "$linked"
    (( copied )) && printf 'copied    %d item(s)\n' "$copied"
    (( ${#skipped[@]} )) && printf 'skipped   %s\n' "${skipped[@]}"
} >&2
printf '%s\n' "$dest"
