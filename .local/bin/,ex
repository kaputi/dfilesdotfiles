#!/usr/bin/env bash
# Extract archives into the current directory without spreading files around:
# an archive with one top-level entry is extracted as is, anything else goes
# into a folder named after the archive. Archives are always kept.
# On a terminal it shows progress: 7z and unrar draw their own, pv the rest.

if [ $# -eq 0 ]; then
    echo "Usage: ,ex <archive>..." >&2
    exit 1
fi

shopt -s nocasematch dotglob nullglob
set -o pipefail

tmp=""
trap '[ -n "$tmp" ] && rm -rf -- "$tmp"; exit 130' INT TERM

bar=false; [ -t 2 ] && bar=true
have_pv=false; command -v pv >/dev/null && have_pv=true
pv_warned=false
sz_progress=0; rar_msgs=q  # 7z -bsp and unrar -id values
if $bar; then sz_progress=2; rar_msgs=cdn; fi

# sets kind (how to extract), comp (decompressor for tar and raw) and stem
# (archive name minus extension) for $1
identify() {
    local name="${1##*/}"
    kind=""; comp=""; stem="${name%.*}"
    case "$name" in
        *.gz|*.tgz|*.Z)     comp=gzip ;;  # gzip also reads compress(1) .Z files
        *.bz2|*.tbz|*.tbz2) comp=bzip2 ;;
        *.xz|*.txz|*.lzma)  comp=xz ;;    # xz also reads .lzma
        *.zst|*.tzst)       comp=zstd ;;
        *.lz)               comp=lzip ;;
    esac
    case "$name" in
        *.tar.gz|*.tar.bz2|*.tar.xz|*.tar.zst|*.tar.lz|*.tar.lzma|*.tar.Z)
                     kind=tar; stem="${name%.*.*}" ;;
        *.tar|*.tgz|*.tbz|*.tbz2|*.txz|*.tzst)
                     kind=tar ;;
        *.zip)       kind=zip ;;
        *.7z)        kind=7z ;;
        *.rar)       kind=rar ;;
        *.gz|*.Z|*.bz2|*.xz|*.lzma|*.zst)
                     kind=raw ;;  # a single compressed file
    esac
}

# commands needed to extract $kind
tools() {
    case "$kind" in
        tar) echo tar $comp ;;
        raw) echo $comp ;;
        zip) echo unzip ;;
        7z)  echo 7z ;;
        rar) echo unrar ;;
    esac
}

# write archive $1 to stdout, through a pv progress bar when $pv
feed() {
    if $pv; then pv -N "${1##*/}" "$1"; else cat "$1"; fi
}

# extract archive $1 into directory $2; raw writes $2/$stem
extract() {
    case "$kind" in
        tar) feed "$1" | tar -xf - ${comp:+-I "$comp"} -C "$2" ;;
        raw) feed "$1" | "$comp" -dcq > "$2/$stem" ;;
        zip)
            if $pv; then
                # unzip prints one line per finished entry and pv counts them;
                # header and symlink notes are dropped, anything else is a
                # warning or error and goes to stderr
                local n; n=$(unzip -Z1 "$1" 2>/dev/null | wc -l)
                unzip "$1" -d "$2" | awk '
                    /^ +(creating|inflating|extracting|linking): / { print; fflush(); next }
                    /^Archive: / { next }
                    /^finishing deferred symbolic links:$/ { links = 1; next }
                    links && / -> / { next }
                    { print > "/dev/stderr" }' |
                    pv -l -s "$n" -N "${1##*/}" >/dev/null
            else
                unzip -q "$1" -d "$2"
            fi ;;
        7z)  7z x -bso0 -bsp"$sz_progress" -o"$2" "$1" ;;
        rar) unrar x -id"$rar_msgs" "$1" "$2/" ;;
    esac
}

# first free name for $1 in the current dir: name, name-2, name-3...
# if $2 is a regular file the extension stays last (notes-2.txt)
freename() {
    local base="$1" ext="" cand="$1" n=2
    if [ -f "$2" ] && [[ $1 == ?*.* ]]; then base="${1%.*}"; ext=".${1##*.}"; fi
    while [ -e "$cand" ] || [ -L "$cand" ]; do
        cand="$base-$n$ext"; n=$((n + 1))
    done
    echo "$cand"
}

status=0
for arg in "$@"; do
    # a leading "-" would be read as an option by the extractors
    f="$arg"; [[ $f == -* ]] && f="./$f"
    if [ ! -f "$f" ]; then
        echo "'$arg' is not a valid file" >&2; status=1; continue
    fi
    identify "$f"
    if [ -z "$kind" ]; then
        echo "'$arg' cannot be extracted via ,ex" >&2; status=1; continue
    fi
    missing=()
    for t in $(tools); do command -v "$t" >/dev/null || missing+=("$t"); done
    if [ ${#missing[@]} -gt 0 ]; then
        # the 7z command comes in the 7zip package
        echo "'$arg' skipped: ${missing[*]} not installed, install it first:" \
             "sudo pacman -S ${missing[*]/#7z/7zip}" >&2
        status=1; continue
    fi
    pv=false
    if $bar && [ "$kind" != 7z ] && [ "$kind" != rar ]; then
        if $have_pv; then
            pv=true
        elif ! $pv_warned; then
            echo "pv not installed, extracting without progress (sudo pacman -S pv)" >&2
            pv_warned=true
        fi
    fi
    tmp=$(mktemp -d ./.ex-XXXXXX) || { status=1; continue; }
    if ! extract "$f" "$tmp"; then
        echo "'$arg' failed to extract" >&2
        rm -rf -- "$tmp"; tmp=""; status=1; continue
    fi
    entries=("$tmp"/*)
    if [ ${#entries[@]} -eq 0 ]; then
        echo "'$arg' is empty" >&2
        rmdir -- "$tmp"
    elif [ ${#entries[@]} -eq 1 ]; then
        # one top-level entry: take it out as is
        dest=$(freename "${entries[0]##*/}" "${entries[0]}")
        if mv -- "${entries[0]}" "$dest"; then
            rmdir -- "$tmp"; echo "$arg -> $dest"
        else
            echo "'$arg' extracted, but left in $tmp" >&2; status=1
        fi
    else
        dest=$(freename "$stem" "$tmp")
        if mv -- "$tmp" "$dest"; then
            echo "$arg -> $dest/"
        else
            echo "'$arg' extracted, but left in $tmp" >&2; status=1
        fi
    fi
    tmp=""
done
exit $status
