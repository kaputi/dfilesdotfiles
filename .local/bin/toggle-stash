#!/usr/bin/env bash

active=$(hyprctl activewindow -j)
workspace=$(echo "$active" | jq -r '.workspace.name')

if [[ "$workspace" == "special:stash" ]]; then
    hyprctl dispatch 'hl.dsp.window.move({ workspace = "e+0" })'
else
    hyprctl dispatch 'hl.dsp.window.move({ workspace = "special:stash", follow = false })'
fi
