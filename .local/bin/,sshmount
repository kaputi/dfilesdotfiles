#!/usr/bin/env bash
# Mount a remote directory over sshfs at a local directory, or unmount it.
# A remote without a path (user@host) mounts the remote home directory.
#
#   ,sshmount user@host[:/path] [DIR]
#   ,sshmount -u [DIR]    unmount
#
# DIR is the local directory (created if missing), default ~/sshfs-mount.

usage() {
    echo "usage: ,sshmount user@host[:/path] [DIR] | -u [DIR]" >&2
    exit 2
}

unmount= args=()
for arg; do
    case $arg in
        -u) unmount=1 ;;
        -* | '') usage ;;
        *) args+=("$arg") ;;
    esac
done
if [[ -n $unmount ]]; then
    ((${#args[@]} <= 1)) || usage
    dir=${args[0]}
else
    ((${#args[@]} == 1 || ${#args[@]} == 2)) || usage
    remote=${args[0]} dir=${args[1]}
fi

# Full real path (no symlinks): it's matched against /proc/self/mounts.
# -m also resolves a dead mount, where stat fails.
target=$(realpath -m -- "${dir:-$HOME/sshfs-mount}")

# Print what's mounted on $target, or fail if nothing is.
# Reads /proc/self/mounts rather than using mountpoint(1), which stats the directory:
# that fails on a dead connection and would report the mount as gone.
# /proc/self/mounts writes backslash, space, tab and newline as \134 \040 \011 \012
# (backslash first, so the others' backslashes aren't escaped again);
# ENVIRON, unlike awk -v, keeps the backslashes.
mounted_source() {
    local t=${target//\\/\\134}
    t=${t// /\\040} t=${t//$'\t'/\\011} t=${t//$'\n'/\\012}
    t=$t awk '$2 == ENVIRON["t"] { print $1; found = 1 } END { exit !found }' /proc/self/mounts
}

if [[ -n $unmount ]]; then
    if ! mounted_source >/dev/null; then
        echo "nothing mounted on $target" >&2
        exit 1
    fi
    if ! fusermount3 -u "$target"; then
        echo "quit nvim and cd out of $target, or force a lazy unmount: fusermount3 -uz $(printf %q "$target")" >&2
        exit 1
    fi
    echo "unmounted $target"
    exit
fi

if src=$(mounted_source); then
    hint=",sshmount -u"
    [[ -n $dir ]] && hint+=" $(printf %q "$target")"
    echo "$src is already mounted on $target, run $hint first" >&2
    exit 1
fi
[[ -d $target ]] || mkdir -p "$target" || exit 1
[[ $remote == *:* ]] || remote+=":"
sshfs "$remote" "$target" -o reconnect,ServerAliveInterval=15,ServerAliveCountMax=3 || exit 1
echo "mounted $remote on $target"
